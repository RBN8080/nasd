# Solo instalar durante la ventana autorizada; sin credenciales.
# Copiar como /etc/nas/njalla/dominio.toml, root:root 0600.
origen = "3fff:2a0:101e:3d82::38"
interfaz = "eth0"
# Obtener IDs del list-records despues de crear registros en consola.
aaaa_id = ""
txt_id = ""
# Opcionales para Fase 4 (requieren token acotado /etc/nas/njalla/vpn.token):
vpn_a_id = ""
vpn_aaaa_id = ""
# Ambos SAN durante transicion; false al retirar dependencias antiguas.
convivencia = true
# Autoridad propia (proyecto 05, VPS de 06_VPS), opcional: sin primario solo Njalla.
# Claves TSIG en /etc/nas/dns05/nas-ddns.key y nas-acme.key (root:root 0600).
# "autoridad" dice cual manda: "njalla" hasta el cambio de NS, despues "propia".
# primario = "192.0.2.53"
# propios = ["192.0.2.53"]
# autoridad = "njalla"
