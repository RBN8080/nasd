# Configuración de nasd — copiar a /etc/nasd/nasd.toml
#
# P4 del charter: CERO SECRETOS EN EL REPOSITORIO, historial incluido.
# Este archivo es un ejemplo y no contiene ninguno. Cuando exista la
# credencial web (D-14, Fase 3), NO va aquí: va por LoadCredential= de
# systemd.

# Punto de montaje del volumen de datos (ADR-0019).
# Dentro debe existir datos/ y estado/parciales/. El servicio los crea si
# faltan, pero el volumen debe estar montado: si no, no arranca (P5).
volumen = "/srv/nas"

[red]
# ADR-0018: se enlaza a la IP de la LAN, NO a 0.0.0.0. Así el proceso ni
# siquiera escucha fuera de la interfaz declarada. El cortafuegos es el
# segundo control independiente, no el único.
direccion = "192.168.1.38"

# ADR-0032: puerto 80, para entrar tecleando solo la IP. systemd concede
# CAP_NET_BIND_SERVICE por AmbientCapabilities; el proceso NO se eleva.
puerto = 80

# --- Fase 6 · TLS (ADR-0046 y ADR-0048) -------------------------------------
#
# «::» y NO «0.0.0.0»: en Go, enlazar a 0.0.0.0 abre SOLO IPv4, y la unica via
# de entrada viable desde Internet es IPv6 —el CGNAT complica la IPv4—. Un
# socket solo-IPv4 dejaria la Fase 6 muerta sin que nada lo delatara.
direccion_tls = "::"
puerto_tls = 443

[tls]
# Rutas del par que emite 15_tls.sh por DNS-01. Si se dejan VACÍAS o se borra
# esta sección, nasd sirve solo HTTP — que es el estado correcto antes de
# tener certificado. Media configuración hace que NO arranque (P5).
#
# nasd las relee cuando cambian de fecha, así que la renovación de cada 60
# días NO exige reiniciar el servicio ni corta subidas en curso.
certificado = "/etc/nas/tls/fullchain.pem"
clave = "/etc/nas/tls/privkey.pem"

[sesion]
# Cuánto dura una sesión de la web antes de tener que volver a entrar, como
# tope ABSOLUTO. Con TLS (ADR-0046) la cookie ya no viaja en claro fuera de
# la LAN, pero sigue sin ser eterna: la web está expuesta a Internet.
# Valor de referencia [R].
duracion_horas = 168

# Cuánto puede estar una sesión SIN ACTIVIDAD antes de caducar — ADR-0059.
# Deslizante: se renueva con cada petición y con cada bloque de una
# descarga o subida en curso. NO CONFUNDIR con plazos.inactividad_s de
# abajo, que es el plazo de E/S de ADR-0026 dentro de una sola petición.
# Valor de referencia [R]; el responsable lo fijó en 5 min frente al minuto
# que pidió al principio, tras conocer el coste de reingresar (3.2-3.6 s de
# PBKDF2 medidos en el nodo).
inactividad_s = 300

[plazos]
# ADR-0026. Plazo POR ACTIVIDAD, en segundos: se renueva con cada avance de
# datos. Los plazos absolutos de net/http (ReadTimeout, WriteTimeout) se
# dejan sin fijar a propósito — cortarían descargas legítimas de 4 GB.
# Valor de referencia [R]: no es criterio de aceptación.
inactividad_s = 60

[avisos]
# Capa de avisos externos — ADR-0073. AQUÍ NO HAY NINGÚN SECRETO.
#
# El token del bot, el chat y la URL del testigo van por LoadCredential= de
# systemd, en /etc/nasd/avisos, igual que la credencial de la web (P4). Lo que
# vive aquí es solo CUÁNDO y CON QUÉ GANAS se avisa.
#
# OJO AL INSTALAR EN UN NODO QUE YA EXISTE: 05_instalar_servicio.sh escribe
# este archivo SOLO la primera vez, así que estas claves NO llegan a un nodo
# que ya tiene su TOML. Los valores por omisión del binario son los que mandan
# allí, y son exactamente los de abajo.

# Cómo se entrega. Valores: "normal", "silencio", "observacion".
#
#   normal       🟢 al resumen · 🟡 y 🔴 inmediatos
#   silencio     🟢 al resumen · 🟡 retenido hasta el resumen · 🔴 INMEDIATO
#   observacion  todo inmediato — para desarrollo o investigación
#
# UN 🔴 NUNCA SE PUEDE SILENCIAR, en ningún modo. No es configurable.
modo = "normal"

# Cada cuánto sale el resumen, EN HORAS. Sale aunque no haya pasado nada: con
# 8 peticiones de Internet en 21 días medidos, un canal que solo habla cuando
# hay problemas es indistinguible de uno roto. Llega sin sonar.
resumen_horas = 24

# Cada cuánto late el nodo al testigo externo, EN SEGUNDOS. Misma cadencia que
# nas-ddns.timer, ya probada en esta red.
#
# EL UMBRAL DE TOLERANCIA NO ESTÁ AQUÍ: vive en el testigo (Period y Grace,
# ADR-0074), fuera del nodo. Es lo que permite ajustarlo sin redesplegar y lo
# que impide que un nodo comprometido lo suba a un año.
latido_s = 300
