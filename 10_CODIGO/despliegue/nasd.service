[Unit]
Description=nasd — servidor de archivos del proyecto NAS
Documentation=https://github.com/RBN8080/nasd
# Sin volumen no hay nada que servir. Ajustar al UUID real tras la Fase 1.
RequiresMountsFor=/srv/nas
After=network-online.target
Wants=network-online.target

[Service]
# Charter §6.2 y 02_ARQUITECTURA.md §11.1. Ninguna de estas líneas es opcional.
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/nasd --config /etc/nasd/nasd.toml
Restart=on-failure
RestartSec=5s
WatchdogSec=30s

# ADR-0020: un único UID escribe en el almacén, venga por SMB o por la web.
# Un archivo subido por una vía es indistinguible de uno subido por la otra.
User=nas
Group=nas

# Endurecimiento (charter §7).
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# AF_INET6 NO ES OPCIONAL DESDE ADR-0044: la web publica entra por IPv6 y el
# socket 443 es de doble pila. Sin esta familia el nodo arranca y NO sirve a
# Internet, que es el sintoma mas caro de diagnosticar que hay aqui.
#
# Esta copia de referencia decia "AF_INET AF_UNIX" hasta el 2026-08-25, mientras
# la unidad que 05_instalar_servicio.sh instala de verdad si traia AF_INET6. La
# que manda es el script (P1); esta habia envejecido porque no la copia nadie.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# ADR-0032 — puerto 80 sin elevar el proceso.
#
# Enlazar un puerto <1024 exige CAP_NET_BIND_SERVICE. systemd se la concede
# al proceso, que SIGUE siendo el usuario nas sin shell. El bounding set la
# deja como UNICA capacidad posible: no puede adquirir ninguna otra.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# ADR-0036 — acceso al firmware para leer la limitación del SoC (RNF-11).
#
# MEDIDO en el nodo con systemd-run, no supuesto:
#   - Este kernel NO publica get_throttled en sysfs. Ninguna ruta, y una
#     búsqueda amplia por /sys no encuentra nada.
#   - vcgencmd abre /dev/vcio_gencmd (0660 root:video), comprobado con strace.
#     NO /dev/vcio (0600 root:root) ni /dev/vchiq.
#   - HACEN FALTA LAS TRES LÍNEAS, y cada una hace algo distinto:
#       SupplementaryGroups   da el permiso del grupo sobre el nodo
#       DeviceAllow           abre la política de cgroup, que PrivateDevices
#                             deja cerrada
#       BindPaths             HACE APARECER el nodo dentro del /dev privado.
#                             DeviceAllow por sí solo NO lo crea: se probó, y
#                             el dispositivo sencillamente no existía dentro.
#
# PrivateDevices=yes SE MANTIENE. Verificado: el /dev del servicio queda con
# los nodos mínimos más vcio_gencmd, y nada más. Y sin el grupo video, la
# misma configuración vuelve a fallar — o sea, no sobra ninguna línea.
#
# SI SE RETIRAN, el servicio no se rompe: degrada a la alarma de subtensión
# del hwmon y lo DICE en /estado. Pero RNF-11 deja de medirse.
#
# EL GUION DE «BindPaths=-» NO ES UN DESCUIDO, y es lo que hace cierta la
# frase de arriba. Sin él, systemd se NIEGA A ARRANCAR LA UNIDAD ENTERA
# cuando /dev/vcio_gencmd no existe — y no existe en ningún equipo que no sea
# una Raspberry Pi. Es decir: la degradación que este comentario prometía era
# en realidad un servicio que no levanta, y el nodo entero se quedaba sin web
# por una medición opcional. Con el guion delante, systemd ignora el montaje
# ausente (systemd.exec(5)) y la degradación es la que aquí se declara.
#
# DeviceAllow sobre un dispositivo que no existe no molesta, y el grupo
# «video» existe en cualquier Debian: esas dos líneas no necesitan guardia.
SupplementaryGroups=video
DeviceAllow=/dev/vcio_gencmd rw
BindPaths=-/dev/vcio_gencmd

# Tercera capa de contención de rutas (04_SEGURIDAD.md §2): aunque
# RutaSegura y os.Root fallaran, el proceso no puede escribir fuera de aquí.
ReadWritePaths=/srv/nas

# ADR-0025 / RES-01: límite duro de memoria. El kernel mata el proceso y
# Restart=on-failure lo levanta — fallo ruidoso, nunca degradación silenciosa.
# VALOR PROVISIONAL: se fija con la medición de RNF-01 en la Fase 2 (§5.3 de
# 02_ARQUITECTURA.md). No es un número medido.
MemoryMax=192M
Environment=GOMEMLIMIT=160MiB

# P4 — el secreto NO vive en el repositorio ni en el TOML. systemd copia el
# archivo a un tmpfs privado del servicio, legible solo por el, y expone su
# ruta en $CREDENTIALS_DIRECTORY. RF-15 y D-14 / ADR-0021.
#
# Sin esto el servicio NO ARRANCA: no existe un modo sin autenticar.
LoadCredential=web:/etc/nasd/credencial

# LA CAPA DE AVISOS NO SE DECLARA AQUÍ — ADR-0073.
#
# Su credencial (/etc/nasd/avisos) llega por un DROP-IN que instala
# 20_APROVISIONAMIENTO/20_avisos.sh, y no por esta unidad. El motivo es
# concreto: LoadCredential= con un archivo que NO EXISTE hace que la unidad no
# arranque, así que ponerla aquí dejaría SIN SERVICIO a cualquier nodo al que no
# se le hayan configurado los avisos — se cambiaría un NAS que funciona por un
# canal de notificaciones.
#
# Con el drop-in, la credencial se declara solo cuando ya existe, y retirar la
# capa entera es borrar un archivo.

# RNF-13: registro estructurado JSON por stdout hacia journald.
StandardOutput=journal
StandardError=journal

# Fase 4 — límite de tasa del diario POR UNIDAD. ADR-0035.
#
# journald descarta mensajes cuando una unidad supera su cupo, y lo hace EN
# SILENCIO salvo por una línea suya. Con el valor por omisión, una ráfaga de
# peticiones —el servicio anota una línea por cada una— podría llevarse por
# delante justo lo que no puede perderse: los BORRADOS de RF-19, que sin
# papelera (D-15) ni segunda copia (D-12) son el único rastro de lo que había.
#
# No se desactiva el límite (0 sería una puerta a llenar el medio de arranque,
# que por P9 es consumible): se sube lo suficiente para que el ritmo real del
# producto no lo roce, y el tamaño total lo acota SystemMaxUse en journald.conf.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=20000

[Install]
WantedBy=multi-user.target
